# Copy to .env.local and fill in. Vite exposes VITE_* vars to the browser.

# Where the agent sends LLM requests (your worker.ts proxy, OpenAI format).
VITE_LLM_PROXY=http://localhost:8787/v1/chat/completions

# Optional: override the default free model. Must be tool-capable. Browse:
# https://openrouter.ai/models?max_price=0  (look for "tools" support)
# VITE_MODEL=moonshotai/kimi-k2.6:free

# Optional: a browser-CORS-friendly remote MCP server's Streamable HTTP endpoint.
# VITE_MCP_URL=https://your-mcp-server.example.com/mcp
