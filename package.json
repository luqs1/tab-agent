{
  "name": "tab-agent",
  "version": "0.9.0",
  "description": "An agent that runs entirely on a browser tab.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:git": "bun test/git-clone.ts",
    "test:e2e": "HEADED=1 bun test/e2e.ts",
    "test:harness:build": "bun build test/harness/harness.ts --outfile test/harness/harness.js --target browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "just-bash": "^3.0.1",
    "pyodide": "^0.27.0"
  },
  "devDependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.38.4",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
